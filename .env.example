# Copy to `.env` and fill in with the CORRECT finance-app Supabase project.
# These are inlined into the client at build time (EXPO_PUBLIC_ prefix), so only
# ever use the anon/publishable key here — never the service-role key.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key
